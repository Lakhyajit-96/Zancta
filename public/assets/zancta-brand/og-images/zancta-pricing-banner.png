<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ZANCTA - Premium Plans</title>
  <style>
    body {
      margin: 0;
      padding: 0;
      background: linear-gradient(135deg, #0A0A0A 0%, #141414 30%, #1E1E1E 60%, #0A0A0A 100%);
      font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      display: flex;
      justify-content: center;
      align-items: center;
      height: 100vh;
      overflow: hidden;
    }
    
    .container {
      position: relative;
      width: 1200px;
      height: 630px;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
    }
    
    .background-pattern {
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background-image: 
        radial-gradient(circle at 30% 40%, rgba(168, 168, 168, 0.08) 0%, transparent 50%),
        radial-gradient(circle at 70% 60%, rgba(64, 64, 64, 0.1) 0%, transparent 40%),
        linear-gradient(rgba(64, 64, 64, 0.05) 1px, transparent 1px),
        linear-gradient(90deg, rgba(64, 64, 64, 0.05) 1px, transparent 1px);
      background-size: 120px 120px, 120px 120px, 80px 80px, 80px 80px;
    }
    
    .metallic-accent {
      position: absolute;
      width: 500px;
      height: 300px;
      background: linear-gradient(180deg, rgba(192, 192, 192, 0.1) 0%, rgba(112, 112, 112, 0.05) 100%);
      top: 25%;
      left: 50%;
      transform: translateX(-50%);
      filter: blur(80px);
    }
    
    .content {
      position: relative;
      z-index: 10;
      text-align: center;
    }
    
    h1 {
      color: #FFFFFF;
      font-size: 72px;
      font-weight: 700;
      letter-spacing: 10px;
      margin: 0 0 24px 0;
    }
    
    .tagline {
      color: #B0B0B0;
      font-size: 28px;
      font-weight: 400;
      letter-spacing: 1px;
      margin: 0 0 60px 0;
    }
    
    .pricing-cards {
      display: flex;
      gap: 40px;
      justify-content: center;
    }
    
    .card {
      width: 400px;
      padding: 48px 40px;
      border-radius: 24px;
      background: linear-gradient(135deg, rgba(40, 40, 40, 0.6) 0%, rgba(28, 28, 28, 0.8) 100%);
      border: 1px solid rgba(120, 120, 120, 0.2);
      backdrop-filter: blur(20px);
    }
    
    .card.premium {
      background: linear-gradient(135deg, rgba(168, 168, 168, 0.15) 0%, rgba(88, 88, 88, 0.1) 100%);
      border: 1px solid rgba(168, 168, 168, 0.3);
      box-shadow: 0 8px 32px rgba(168, 168, 168, 0.15);
    }
    
    .plan-name {
      color: #D0D0D0;
      font-size: 18px;
      font-weight: 600;
      letter-spacing: 2px;
      text-transform: uppercase;
      margin: 0 0 16px 0;
    }
    
    .plan-price {
      color: #FFFFFF;
      font-size: 56px;
      font-weight: 700;
      letter-spacing: 1px;
      margin: 0 0 8px 0;
    }
    
    .plan-period {
      color: #888888;
      font-size: 18px;
      font-weight: 400;
      margin: 0 0 32px 0;
    }
    
    .benefits {
      text-align: left;
    }
    
    .benefit {
      color: #A0A0A0;
      font-size: 16px;
      font-weight: 500;
      padding: 12px 0;
      display: flex;
      align-items: center;
      gap: 16px;
      border-bottom: 1px solid rgba(120, 120, 120, 0.1);
    }
    
    .benefit:last-child {
      border-bottom: none;
    }
    
    .check-icon {
      width: 20px;
      height: 20px;
      background: linear-gradient(135deg, #C8C8C8 0%, #969696 100%);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }
    
    .check-icon::after {
      content: '';
      width: 8px;
      height: 8px;
      background: #1A1A1A;
      clip-path: polygon(20% 50%, 45% 75%, 80% 20%);
    }
    
    .premium-badge {
      position: absolute;
      top: -16px;
      left: 50%;
      transform: translateX(-50%);
      background: linear-gradient(135deg, #C8C8C8 0%, #969696 100%);
      color: #0A0A0A;
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 1px;
      text-transform: uppercase;
      padding: 8px 24px;
      border-radius: 12px;
      white-space: nowrap;
    }
  </style>
</head>
<body>
  <div class="container">
    <div class="background-pattern"></div>
    <div class="metallic-accent"></div>
    
    <div class="content">
      <h1>CHOOSE YOUR PLAN</h1>
      <p class="tagline">Powerful local-first tools, no compromises on privacy</p>
      
      <div class="pricing-cards">
        <div class="card">
          <div class="plan-name">Free</div>
          <div class="plan-price">$0</div>
          <div class="plan-period">forever</div>
          
          <div class="benefits">
            <div class="benefit">
              <div class="check-icon"></div>
              <span>9 local-first tools</span>
            </div>
            <div class="benefit">
              <div class="check-icon"></div>
              <span>50 MB file limit</span>
            </div>
            <div class="benefit">
              <div class="check-icon"></div>
              <span>No ads in tools</span>
            </div>
            <div class="benefit">
              <div class="check-icon"></div>
              <span>All processing local</span>
            </div>
          </div>
        </div>
        
        <div class="card premium">
          <div class="premium-badge">Best Value</div>
          <div class="plan-name">Premium</div>
          <div class="plan-price">$39</div>
          <div class="plan-period">one-time payment</div>
          
          <div class="benefits">
            <div class="benefit">
              <div class="check-icon"></div>
              <span>Everything in Free</span>
            </div>
            <div class="benefit">
              <div class="check-icon"></div>
              <span>100 MB per file</span>
            </div>
            <div class="benefit">
              <div class="check-icon"></div>
              <span>Larger batch limits</span>
            </div>
            <div class="benefit">
              <div class="check-icon"></div>
              <span>Priority support</span>
            </div>
            <div class="benefit">
              <div class="check-icon"></div>
              <span>Early access to new tools</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</body>
</html>
