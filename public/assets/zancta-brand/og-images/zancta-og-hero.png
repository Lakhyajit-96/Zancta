<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ZANCTA - Your Files Stay Private</title>
  <style>
    body {
      margin: 0;
      padding: 0;
      background: linear-gradient(135deg, #0A0A0A 0%, #1A1A1A 50%, #0A0A0A 100%);
      font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      display: flex;
      justify-content: center;
      align-items: center;
      height: 100vh;
      overflow: hidden;
    }
    
    .container {
      position: relative;
      width: 1200px;
      height: 630px;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
    }
    
    .background-grid {
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background-image: 
        linear-gradient(rgba(64, 64, 64, 0.1) 1px, transparent 1px),
        linear-gradient(90deg, rgba(64, 64, 64, 0.1) 1px, transparent 1px);
      background-size: 60px 60px;
      opacity: 0.3;
    }
    
    .luminous-accent {
      position: absolute;
      width: 400px;
      height: 400px;
      background: radial-gradient(circle, rgba(168, 168, 168, 0.15) 0%, transparent 70%);
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      filter: blur(60px);
    }
    
    .content {
      position: relative;
      z-index: 10;
      text-align: center;
    }
    
    .logo-mark {
      width: 120px;
      height: 120px;
      fill: linear-gradient(to bottom, #F5F5F5, #787878);
      margin-bottom: 40px;
      filter: drop-shadow(0 0 20px rgba(168, 168, 168, 0.3));
    }
    
    h1 {
      color: #FFFFFF;
      font-size: 82px;
      font-weight: 700;
      letter-spacing: 12px;
      margin: 0 0 20px 0;
      text-shadow: 0 0 30px rgba(255, 255, 255, 0.3);
    }
    
    .tagline {
      color: #A8A8A8;
      font-size: 32px;
      font-weight: 400;
      letter-spacing: 2px;
      margin: 0;
      text-shadow: 0 0 20px rgba(168, 168, 168, 0.2);
    }
    
    .divider {
      width: 300px;
      height: 1px;
      background: linear-gradient(90deg, transparent 0%, #606060 50%, transparent 100%);
      margin: 40px auto;
    }
    
    .features {
      display: flex;
      gap: 60px;
      justify-content: center;
      margin-top: 40px;
    }
    
    .feature {
      text-align: center;
    }
    
    .feature-icon {
      width: 48px;
      height: 48px;
      margin-bottom: 16px;
    }
    
    .feature-text {
      color: #787878;
      font-size: 18px;
      font-weight: 500;
      letter-spacing: 1px;
    }
  </style>
</head>
<body>
  <div class="container">
    <div class="background-grid"></div>
    <div class="luminous-accent"></div>
    
    <div class="content">
      <!-- Compact Z mark -->
      <svg class="logo-mark" viewBox="0 0 80 80">
        <defs>
          <linearGradient id="og-metallic" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" style="stop-color:#F5F5F5"/>
            <stop offset="25%" style="stop-color:#D4D4D4"/>
            <stop offset="50%" style="stop-color:#A8A8A8"/>
            <stop offset="75%" style="stop-color:#8C8C8C"/>
            <stop offset="100%" style="stop-color:#787878"/>
          </linearGradient>
        </defs>
        <rect width="80" height="80" fill="#0A0A0A"/>
        <path d="M 60 12 L 20 12 L 20 28 L 52 28 L 28 52 L 28 36 L 12 36 L 12 68 L 68 68 L 68 52 L 36 52 L 60 28 L 60 44 L 76 44 L 76 12 Z" 
              fill="url(#og-metallic)"/>
      </svg>
      
      <h1>ZANCTA</h1>
      <p class="tagline">Your files never leave your device.</p>
      
      <div class="divider"></div>
      
      <div class="features">
        <div class="feature">
          <div class="feature-icon">🔒</div>
          <div class="feature-text">LOCAL-FIRST</div>
        </div>
        <div class="feature">
          <div class="feature-icon">🛡️</div>
          <div class="feature-text">PRIVATE</div>
        </div>
        <div class="feature">
          <div class="feature-icon">⚡</div>
          <div class="feature-text">FAST</div>
        </div>
      </div>
    </div>
  </div>
</body>
</html>
