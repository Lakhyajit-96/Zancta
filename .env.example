# Environment Variables — Template
# Copy to .env and fill. Never commit real secrets.
# See docs/SECURITY_FOUNDATION.md

# === App ===
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=ZANCTA

# === Database ===
# SQLite for local dev:
DATABASE_URL="file:./prisma/dev.db"
# PostgreSQL for production:
# DATABASE_URL="postgresql://user:pass@host:5432/toolsite"

# === Auth ===
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET= # generate: openssl rand -base64 32
# Auth.js v5 also reads AUTH_SECRET (takes precedence, alt is NEXTAUTH_SECRET)
# AUTH_SECRET= # generate: openssl rand -base64 32
AUTH_TRUST_HOST=true
# Optional: set to false ONLY for local http browser testing (e.g. WebKit e2e on localhost).
# Leave unset in production so auth cookies stay Secure.
# AUTH_USE_SECURE_COOKIES=false
# OAuth (Google + GitHub via Auth.js v5)
# Callback URLs to register:
#   Google Cloud Console > OAuth client > Authorized redirect URIs:
#     http://localhost:3000/api/auth/callback/google  (local)
#     https://<your-domain>/api/auth/callback/google  (production)
#   GitHub OAuth App > Authorization callback URL:
#     http://localhost:3000/api/auth/callback/github  (local)
#     https://<your-domain>/api/auth/callback/github  (production)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# === Email (prod Resend, dev console) ===
RESEND_API_KEY= # resend_... (production)
EMAIL_FROM=noreply@your-verified-sending-domain.com

# === Rate Limiting (Upstash Redis — optional in dev, required for prod distributed) ===
UPSTASH_REDIS_REST_URL= # https://...upstash.io
UPSTASH_REDIS_REST_TOKEN= # token

# === Payments (Dodo MoR — test mode first) ===
# Do not set prod keys in dev.
PAYMENTS_PROVIDER=dodo
DODO_API_KEY= # Bearer token from Dodo Dashboard > Developer > API Keys (test mode)
DODO_WEBHOOK_SECRET= # whsec_... from Dashboard > Webhooks (test mode)
# Alternate name accepted: DODO_PAYMENTS_WEBHOOK_SECRET
DODO_ENVIRONMENT=test # test | live
DODO_PRODUCT_MONTHLY_ID= # product_id for PREMIUM_MONTHLY (₹199)
DODO_PRODUCT_ANNUAL_ID= # product_id for PREMIUM_ANNUAL (₹999)

# === Analytics (optional) ===
NEXT_PUBLIC_GA_MEASUREMENT_ID=
