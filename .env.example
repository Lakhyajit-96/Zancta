# ZANCTA environment template
# Copy to .env (and optionally .env.local). Never commit real secrets.
# Authoritative inventory: docs/operations/environment.md
# Name-only presence check: node scripts/report-env-presence.mjs

# ==========================================
# ZANCTA — APPLICATION
# ==========================================
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Display name. Not read by application code today; safe to omit.
# NEXT_PUBLIC_APP_NAME=ZANCTA

# ==========================================
# DATABASE
# ==========================================
# Prisma schema provider is postgresql. SQLite file: URLs are not compatible with this schema on Prisma 7.
# Empty local Postgres: npm run migrate:bootstrap (do not prisma migrate deploy historical SQLite SQL).
# Production migrate: docs/operations/migrations.md — never prisma db push.
DATABASE_URL=postgresql://user:pass@127.0.0.1:5432/zancta
# Optional. Set disable/false only for local non-TLS Postgres. Hosted Postgres uses TLS by default.
# DATABASE_SSL=disable

# ==========================================
# AUTHENTICATION
# ==========================================
NEXTAUTH_URL=http://localhost:3000
# Auth.js v5: AUTH_SECRET takes precedence; NEXTAUTH_SECRET is the accepted alias.
AUTH_SECRET=
# NEXTAUTH_SECRET=
AUTH_TRUST_HOST=true
# Set false ONLY for local http browser testing (e.g. WebKit e2e). Leave unset in production.
# AUTH_USE_SECURE_COOKIES=false
# Optional Auth.js origin alias used only as a fallback in lib/seo.ts
# AUTH_URL=http://localhost:3000

# ==========================================
# OAUTH
# ==========================================
# Google Cloud Console > OAuth client > Authorized redirect URIs:
#   http://localhost:3000/api/auth/callback/google
#   https://zancta.tech/api/auth/callback/google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GitHub OAuth App > Authorization callback URL:
#   http://localhost:3000/api/auth/callback/github
#   https://zancta.tech/api/auth/callback/github
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# ==========================================
# EMAIL / RESEND
# ==========================================
# Local without a key logs to the console. Production requires a live Resend key.
RESEND_API_KEY=
EMAIL_FROM=noreply@mail.zancta.tech
EMAIL_REPLY_TO=support@zancta.tech

# ==========================================
# PAYMENTS / DODO
# ==========================================
PAYMENTS_PROVIDER=dodo
DODO_API_KEY=
DODO_WEBHOOK_SECRET=
# Alias accepted by code: DODO_PAYMENTS_WEBHOOK_SECRET
DODO_ENVIRONMENT=test
DODO_PRODUCT_MONTHLY_ID=
DODO_PRODUCT_ANNUAL_ID=
# Aliases accepted by code: DODO_PAYMENTS_PRODUCT_MONTHLY_ID / DODO_PAYMENTS_PRODUCT_ANNUAL_ID
# Live charges only when this is the string true AND DODO_ENVIRONMENT=live AND product IDs exist.
PAYMENTS_LIVE_ENABLED=false

# ==========================================
# ANALYTICS / GA4
# ==========================================
# Measurement ID only (G-XXXXXXXX). Loads in the browser after analytics consent. Never put a secret here.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ==========================================
# OBSERVABILITY / SENTRY
# ==========================================
# Optional. App is inert without a DSN. Prefer the server DSN; do not put a secret in NEXT_PUBLIC_*.
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=

# ==========================================
# INDEXNOW / SEARCH DISTRIBUTION
# ==========================================
# Server-only. Never prefix with NEXT_PUBLIC_.
# INDEXNOW_KEY = Bing-generated ownership key (served as /{key}.txt).
# INDEXNOW_NOTIFY_SECRET = internal auth for POST /api/indexnow only. Not part of the IndexNow protocol.
INDEXNOW_KEY=
INDEXNOW_NOTIFY_SECRET=

# ==========================================
# OPERATOR SEARCH / ANALYTICS APIS (Production only)
# ==========================================
# Never set these on Vercel Preview. Never prefix with NEXT_PUBLIC_.
# 32-byte key as 64 hex chars. Used to encrypt stored OAuth refresh tokens.
# INTEGRATION_ENCRYPTION_KEY=
# Dedicated Google Cloud OAuth client (Web). Redirect:
#   https://zancta.tech/api/admin/integrations/google/callback
# GOOGLE_OPERATOR_CLIENT_ID=
# GOOGLE_OPERATOR_CLIENT_SECRET=
# Bing Webmaster OAuth client. Redirect:
#   https://zancta.tech/api/admin/integrations/bing/callback
# BING_WEBMASTER_CLIENT_ID=
# BING_WEBMASTER_CLIENT_SECRET=
# CLI only (scripts/promote-operator-admin.mjs). Never grant ADMIN because of Google login.
# Never set this on Vercel Preview. Not read by the Next.js app.
# OPERATOR_ADMIN_EMAIL=

# ==========================================
# SEO / PUBLIC CONFIGURATION
# ==========================================
# Canonical origin in production is hard-coded to https://zancta.tech when NODE_ENV=production.
# NEXT_PUBLIC_APP_URL / NEXTAUTH_URL still matter for local/preview and Auth.js.

# ==========================================
# STORAGE / INFRASTRUCTURE
# ==========================================
# Optional locally. Required for distributed rate limiting in production.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ==========================================
# ADS (keep off)
# ==========================================
NEXT_PUBLIC_ADS_ENABLED=false

# ==========================================
# VERCEL PREVIEW ISOLATION
# ==========================================
# Do not set these on Production. Defaults (unset) keep Preview HTTP from
# mutating data or sending Resend mail. Preview already has a separate database.
# Leave these unset unless you intentionally want Preview /api writes.
# PREVIEW_ALLOW_PRODUCTION_MUTATIONS=true
# PREVIEW_ALLOW_PRODUCTION_EMAIL=true
# PREVIEW_ALLOW_PRODUCTION_DATA=true

# ==========================================
# DEVELOPMENT / TESTING
# ==========================================
# Vitest/Playwright Postgres from docker-compose.test.yml (port 54329). tests/setup.ts overrides DATABASE_URL.
# TEST_DATABASE_URL=postgresql://zancta:zancta@127.0.0.1:54329/zancta_test
