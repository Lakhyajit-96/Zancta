# ZANCTA — production environment template
# Fill these in Vercel Production (and keep a local copy only in gitignored .env.production).
# Do not commit real values. See docs/ENVIRONMENT_CONFIGURATION.md.

# ==========================================
# APPLICATION
# ==========================================
# Set automatically by Next.js / Vercel. Do not set NODE_ENV=development in Production.
# NODE_ENV=production
# Canonical public origin. Used for local/preview URL resolution; production canonical is https://zancta.tech in code.
NEXT_PUBLIC_APP_URL=https://zancta.tech

# ==========================================
# DATABASE
# ==========================================
# Obtain from the production Postgres provider (Prisma/Vercel/Neon/etc.). Never use the test Docker URL.
DATABASE_URL=
# Leave unset unless a specific host requires disabling TLS (do not disable on hosted Postgres).
# DATABASE_SSL=

# ==========================================
# AUTHENTICATION
# ==========================================
# Generate a strong random secret (openssl rand -base64 32). Never reuse a leaked value.
AUTH_SECRET=
# Optional alias if AUTH_SECRET is unset. Prefer AUTH_SECRET.
# NEXTAUTH_SECRET=
# Auth.js canonical URL for callbacks and email links.
NEXTAUTH_URL=https://zancta.tech
# Required on Vercel so Auth.js trusts the forwarded host.
AUTH_TRUST_HOST=true
# Do not set AUTH_USE_SECURE_COOKIES=false in production.

# ==========================================
# OAUTH
# ==========================================
# Obtain from Google Cloud Console OAuth client. Redirect: https://zancta.tech/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Obtain from GitHub OAuth App. Callback: https://zancta.tech/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ==========================================
# EMAIL / RESEND
# ==========================================
# Obtain from the Resend dashboard API keys.
RESEND_API_KEY=
# Verified Resend sender on mail.zancta.tech
EMAIL_FROM=noreply@mail.zancta.tech
# ZANCTA support mailbox (Reply-To). Override of the legal-public default for support mail.
EMAIL_REPLY_TO=support@zancta.tech

# ==========================================
# PAYMENTS / DODO
# ==========================================
PAYMENTS_PROVIDER=dodo
# Obtain from Dodo Dashboard > Developer > API Keys
DODO_API_KEY=
# Obtain from Dodo Dashboard > Webhooks (whsec_…)
DODO_WEBHOOK_SECRET=
# test until live checkout is intentionally enabled
DODO_ENVIRONMENT=test
# Dodo product IDs for Premium monthly / annual
DODO_PRODUCT_MONTHLY_ID=
DODO_PRODUCT_ANNUAL_ID=
# Must remain false until live checkout is authorized. Checkout is live only when this is true AND DODO_ENVIRONMENT=live.
PAYMENTS_LIVE_ENABLED=false

# ==========================================
# ANALYTICS / GA4
# ==========================================
# Obtain from Google Analytics 4 > Admin > Data streams > Measurement ID (G-…). Public by design.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ==========================================
# INDEXNOW / SEARCH DISTRIBUTION
# ==========================================
# Obtain from Bing IndexNow key generator. Ownership key only. Never NEXT_PUBLIC_.
INDEXNOW_KEY=
# Generate a separate random secret for POST /api/indexnow operator auth. Not the IndexNow protocol key.
INDEXNOW_NOTIFY_SECRET=

# ==========================================
# RATE LIMITING
# ==========================================
# Obtain from Upstash Redis REST credentials. Production rate limits fail closed without these.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ==========================================
# OBSERVABILITY / ADS (optional — keep ads off)
# ==========================================
# Obtain from Sentry only if a project is purchased later. Leave empty to keep Sentry inert.
# SENTRY_DSN=
NEXT_PUBLIC_ADS_ENABLED=false
