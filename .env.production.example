# ZANCTA production environment template
# Names and non-secret placeholders only. Never commit real secrets.
# Authoritative inventory: docs/operations/environment.md
# Vercel project: docs/operations/vercel.md

# ==========================================
# APPLICATION
# ==========================================
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://zancta.tech
# Display name. Not read by application code today; safe to omit.
# NEXT_PUBLIC_APP_NAME=ZANCTA

# ==========================================
# DATABASE
# ==========================================
# Production must be Postgres. Do not use SQLite file: URLs.
DATABASE_URL=
# DATABASE_SSL is local-only. Do not set disable/false in production.

# ==========================================
# AUTHENTICATION
# ==========================================
NEXTAUTH_URL=https://zancta.tech
AUTH_SECRET=
# NEXTAUTH_SECRET=
AUTH_TRUST_HOST=true
# Do not set AUTH_USE_SECURE_COOKIES=false in production.

# ==========================================
# OAUTH (optional; hide buttons if a pair is incomplete)
# ==========================================
# Google redirect: https://zancta.tech/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub callback: https://zancta.tech/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ==========================================
# EMAIL / RESEND
# ==========================================
RESEND_API_KEY=
EMAIL_FROM=noreply@mail.zancta.tech
EMAIL_REPLY_TO=support@zancta.tech

# ==========================================
# PAYMENTS / DODO
# ==========================================
PAYMENTS_PROVIDER=dodo
DODO_API_KEY=
DODO_WEBHOOK_SECRET=
DODO_ENVIRONMENT=test
DODO_PRODUCT_MONTHLY_ID=
DODO_PRODUCT_ANNUAL_ID=
# Live charges only when this is the string true AND DODO_ENVIRONMENT=live AND product IDs exist.
# Do not set true without explicit owner authorization.
PAYMENTS_LIVE_ENABLED=false

# ==========================================
# ANALYTICS / GA4
# ==========================================
# Measurement ID only (G-XXXXXXXX). Loads after analytics consent.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ==========================================
# OBSERVABILITY / SENTRY
# ==========================================
# Optional. App is inert without a DSN. Do not purchase for this phase.
# SENTRY_DSN=

# ==========================================
# INDEXNOW / SEARCH DISTRIBUTION
# ==========================================
# Server-only. Never prefix with NEXT_PUBLIC_. Production-only on Vercel today.
INDEXNOW_KEY=
INDEXNOW_NOTIFY_SECRET=

# ==========================================
# RATE LIMITING / UPSTASH
# ==========================================
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ==========================================
# ADS (keep off)
# ==========================================
NEXT_PUBLIC_ADS_ENABLED=false

# Never set PREVIEW_ALLOW_PRODUCTION_* on Production.
