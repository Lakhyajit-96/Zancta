{
  "name": "zancta",
  "version": "0.1.0",
  "private": true,
  "description": "Privacy-first PDF and image tools that run in your browser.",
  "type": "module",
  "engines": {
    "node": ">=20 <25",
    "npm": ">=10"
  },
  "packageManager": "npm@11.13.0",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build --webpack",
    "postinstall": "prisma generate",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "operator:promote-admin": "node scripts/promote-operator-admin.mjs --production --confirm",
    "migrate:checksums": "node scripts/migrate.mjs checksums",
    "migrate:baseline": "node scripts/migrate.mjs write-baseline",
    "migrate:status": "node scripts/migrate.mjs status",
    "migrate:bootstrap": "node scripts/migrate.mjs bootstrap",
    "migrate:deploy": "node scripts/migrate.mjs deploy",
    "migrate:verify": "node scripts/migrate.mjs verify",
    "operator:production-release": "node scripts/operator-production-release.mjs",
    "test:db:up": "docker compose -f docker-compose.test.yml up -d --wait",
    "test:db:schema": "node tests/apply-test-schema.mjs",
    "test:db:down": "docker compose -f docker-compose.test.yml down",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit": "npm audit --audit-level=moderate"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@prisma/adapter-better-sqlite3": "^7.10.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.2",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "browser-image-compression": "^2.0.2",
    "framer-motion": "^12.0.0",
    "jszip": "^3.10.1",
    "next": "16.3.0",
    "next-auth": "^5.0.0-beta.32",
    "nodemailer": "9.0.5",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.1.91",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.19.0",
    "tesseract.js": "^7.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "^1.53.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "axe-core": "^4.10.0",
    "canvas": "^3.2.3",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "jsdom": "^26.0.0",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.0.0"
  },
  "keywords": [
    "tools",
    "nextjs",
    "production",
    "privacy",
    "pdf",
    "image"
  ],
  "license": "SEE LICENSE IN LICENSE",
  "overrides": {
    "nodemailer": "9.0.5",
    "deepmerge-ts": "8.0.2",
    "fast-uri": "3.1.6",
    "mysql2": "3.24.3"
  }
}
